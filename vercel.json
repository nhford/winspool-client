{
    "rewrites": [
      {
        "source": "/:sport(mlb|nba|nfl|wnba|fantasy|traitors)",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/team_logos/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, must-revalidate"
          }
        ]
      }
    ]
  }
  